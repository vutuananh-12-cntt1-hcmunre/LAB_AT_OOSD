        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam conditionStyle diamond\ntitle Activity Diagram: Xem thông tin tham vấn &amp; Dự thảo chính sách\n\n|Người tham gia|\nstart\n:Truy cập hệ thống;\n:Chọn xem \&quot;Thông tin tham vấn\&quot; hoặc \&quot;Dự thảo chính sách\&quot;;\n\n|Hệ thống|\n:Hiển thị danh sách các chủ đề tham vấn / dự thảo;\n\n|Người tham gia|\n:Nhập từ khóa tìm kiếm hoặc lọc theo trạng thái (tùy chọn);\n:Chọn một chủ đề hoặc dự thảo cụ thể cần xem;\n\n|Hệ thống|\n:Truy vấn CSDL tìm thông tin;\nif (Tìm thấy dữ liệu?) then (Không)\n  :Thông báo \&quot;Không tìm thấy thông tin phù hợp\&quot;;\n  stop\nelse (Có)\n  :Hiển thị nội dung chi tiết: Tên chủ đề, mô tả, hạn tiếp nhận, phiên bản dự thảo;\nendif\n\n|Người tham gia|\nif (Muốn tải tệp dự thảo về?) then (Có)\n  :Nhấn nút \&quot;Tải về tệp dự thảo\&quot;;\n  |Hệ thống|\n  :Tải file văn bản dự thảo về thiết bị;\nelse (Không)\nendif\n\n|Người tham gia|\n:Đọc nội dung và kết thúc tra cứu;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NQy91lEUHq9SP_oymKbi-238">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Người tham gia" plantUmlId="lane_54" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;" plantUmlBaseValue="Người tham gia" id="NQy91lEUHq9SP_oymKbi-239">
