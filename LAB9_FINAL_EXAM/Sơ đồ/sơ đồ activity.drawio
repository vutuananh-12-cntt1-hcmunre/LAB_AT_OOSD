        <UserObject label="Activity Diagram: Phản hồi ý kiến" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram: Phản hồi ý kiến" id="ea6zS_9v5ffsTkkczIDn-1131">
