        <UserObject label="Activity Diagram: Xem thông tin tham vấn &amp;amp; Dự thảo chính sách" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram: Xem thông tin tham vấn &amp;amp; Dự thảo chính sách" id="ea6zS_9v5ffsTkkczIDn-895">
