        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Nhân viên\&quot; as NV\nactor \&quot;NV lễ tân\&quot; as LT\nactor \&quot;NV phục vụ\\nphòng\&quot; as PV\nactor \&quot;NV thanh\\ntoán\&quot; as TT\nactor \&quot;Quản lý\&quot; as QL\n\nLT -up-|&gt; NV\nPV -up-|&gt; NV\nTT -up-|&gt; NV\n\nrectangle \&quot;HỆ THỐNG QUẢN LÝ KHÁCH SẠN\&quot; {\n  usecase \&quot;Quản lý danh mục\&quot; as UC_QLDM\n  usecase \&quot;Ghi nhận dịch vụ\&quot; as UC_GNDV\n  \n  usecase \&quot;Đặt phòng\&quot; as UC_DP\n  usecase \&quot;Nhận phòng\&quot; as UC_NP\n  usecase \&quot;Ghi nhận người lưu trú\&quot; as UC_GNNLT\n  \n  usecase \&quot;Quản lý phòng - tiện nghi\&quot; as UC_QLPTN\n  usecase \&quot;Lập phiếu lắp đặt\&quot; as UC_LPLD\n  \n  usecase \&quot;Trả phòng\&quot; as UC_TP\n  usecase \&quot;Lập phiếu đền bù\&quot; as UC_LPDB\n  usecase \&quot;Thanh toán\&quot; as UC_TT\n  usecase \&quot;Lập hóa đơn\&quot; as UC_LHD\n  \n  usecase \&quot;Tra cứu / thống kê\&quot; as UC_TCTK\n}\n\nNV -- UC_QLDM\nNV -- UC_GNDV\n\nLT -- UC_DP\nLT -- UC_NP\nUC_NP ..&gt; UC_GNNLT : &lt;&lt;include&gt;&gt;\n\nPV -- UC_QLPTN\nPV -- UC_LPLD\nPV -- UC_LPDB\nUC_TP ..&gt; UC_LPDB : &lt;&lt;extend&gt;&gt;\n\nTT -- UC_TP\nTT -- UC_TT\nTT -- UC_LHD\n\nQL -- UC_TCTK\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zeRpBaMOKUDpEmXrLsBg-1">
